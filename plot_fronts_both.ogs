// =====================================================================
// Both ice fronts at once: 4 systems x 2 fronts = 8 curves
//
// Run inside Origin: open the Command Window (Shift+F3) and type
//     run.file("FULL_PATH_TO_THIS_FILE")
//
// BEFORE RUNNING: set root$ below to the folder that holds your CSV files.
//
// The lower front moves down over time (z decreases) and the upper front
// moves up (z increases), so the curves form two symmetric groups.
// =====================================================================

// ---- EDIT THIS ----
string root$ = "G:\MD_useful\ice_analysis";
// -------------------

string outdir$ = root$ + "\origin_output";

// ---- 1. new workbook and import ----
newbook name:="BothFronts" sheet:=1;
impasc fname:=root$ + "\origin_data\origin_fronts_both.csv";

// ---- 2. first column as X ----
wks.col1.type = 4;

// ---- 3. eight curves: X = col 1, Y = cols 2..9 ----
plotxy iy:=(1,2:9) plot:=202;

// ---- 4. axis titles ----
xb.text$ = "t (ns)";
yl.text$ = "front position (nm)";

// ---- 5. export ----
expGraph type:=png path:=outdir$ filename:="fronts_both" overwrite:=replace;
type "PNG exported to " + outdir$;

type "plot_fronts_both.ogs finished";
