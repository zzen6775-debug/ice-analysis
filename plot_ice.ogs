// =====================================================================
// Ice thickness vs time: import CSV -> plot -> axis titles -> export PNG
//
// Run inside Origin: open the Command Window (Shift+F3) and type
//     run.file("FULL_PATH_TO_THIS_FILE")
//
// BEFORE RUNNING: set root$ below to the folder that holds your CSV files.
// =====================================================================

// ---- EDIT THIS ----
string root$ = "G:\MD_useful\ice_analysis";
// -------------------

string outdir$ = root$ + "\origin_output";

// ---- 1. new workbook and import ----
newbook name:="IceGrowth" sheet:=1;
impasc fname:=root$ + "\origin_data\origin_thickness.csv";

// ---- 2. first column as X ----
wks.col1.type = 4;

// ---- 3. line + symbol, X = col 1, Y = cols 2..5 ----
plotxy iy:=(1,2:5) plot:=202;

// ---- 4. axis titles (axis objects override the auto long-name title) ----
xb.text$ = "t (ns)";
yl.text$ = "Ice thickness (nm)";

// ---- 5. export ----
expGraph type:=png path:=outdir$ filename:="ice_growth" overwrite:=replace;
type "PNG exported to " + outdir$;

type "plot_ice.ogs finished";
